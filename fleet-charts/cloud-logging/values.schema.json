{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "projectId": {
      "description": "GCP Fleet Project ID",
      "type": "string",
      "minLength": 1
    },
    "membershipName": {
      "description": "Fleet Membership Name",
      "type": "string",
      "minLength": 1
    },
    "location": {
      "description": "Cloud Logging Monitored Resource location",
      "type": "string",
      "minLength": 1
    },
    "membershipLocation": {
      "description": "Fleet Membership Location",
      "type": "string",
      "minLength": 1
    },
    "clusterName": {
      "description": "Cluster Name for Cloud Logging Monitored Resource labels (defaults to membershipName if empty)",
      "type": "string"
    },
    "namespace": {
      "description": "Kubernetes Namespace for the Cloud Logging OpenTelemetry Collector",
      "type": "string",
      "minLength": 1
    },
    "serviceAccountEmail": {
      "description": "Optional Google Cloud Service Account email for Fleet Workload Identity impersonation",
      "type": "string"
    },
    "useProjectedKsaToken": {
      "description": "Authenticate with a projected KSA token and external_account credentials (true), or rely on the GKE metadata server (false)",
      "type": "boolean"
    },
    "image": {
      "description": "OpenTelemetry Collector container image configuration",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "systemLogs": {
      "description": "Host system log file paths configuration",
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "include"
      ]
    },
    "resources": {
      "description": "Container resource requests and limits",
      "type": "object"
    },
    "tolerations": {
      "description": "Pod tolerations for the DaemonSet",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "description": "Kubernetes events collection (single-replica Deployment)",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Collect Kubernetes events into the events log",
          "type": "boolean"
        },
        "resources": {
          "description": "Container resource requests and limits for the events Deployment",
          "type": "object"
        },
        "nodeSelector": {
          "description": "Node selector for the events Deployment",
          "type": "object"
        },
        "tolerations": {
          "description": "Pod tolerations for the events Deployment",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "journald": {
      "description": "Host system logs from journald via a Fluent Bit sidecar",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Collect host logs from journald",
          "type": "boolean"
        },
        "units": {
          "description": "systemd units to collect, with their type suffix (for example kubelet.service)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s=]+\\.(service|socket|scope|slice|mount|automount|swap|target|path|timer|device)$"
          }
        },
        "kernel": {
          "description": "Also collect kernel messages",
          "type": "boolean"
        },
        "image": {
          "description": "journald reader (Fluent Bit) container image",
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repository",
            "tag"
          ]
        },
        "resources": {
          "description": "Container resource requests and limits for the journald reader",
          "type": "object"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "projectId",
    "membershipName",
    "location",
    "membershipLocation",
    "namespace",
    "image",
    "systemLogs",
    "events",
    "journald"
  ]
}
