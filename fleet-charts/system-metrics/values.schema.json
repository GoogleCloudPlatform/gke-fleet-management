{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "projectId": {
      "description": "GCP Fleet Project ID",
      "type": "string",
      "minLength": 1
    },
    "membershipName": {
      "description": "Fleet Membership Name",
      "type": "string",
      "minLength": 1
    },
    "location": {
      "description": "Cloud Monitoring location (GCP region or zone, e.g., us-central1)",
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "global"
      }
    },
    "membershipLocation": {
      "description": "Fleet Membership Location",
      "type": "string",
      "minLength": 1
    },
    "clusterName": {
      "description": "Cluster Name for Cloud Monitoring Monitored Resource labels (defaults to membershipName if empty)",
      "type": "string"
    },
    "namespace": {
      "description": "Kubernetes Namespace for the System Metrics OpenTelemetry Collector",
      "type": "string",
      "minLength": 1
    },
    "serviceAccountEmail": {
      "description": "Optional Google Cloud Service Account email for Fleet Workload Identity impersonation",
      "type": "string"
    },
    "collectionInterval": {
      "description": "Metric collection interval for hostmetrics and kubeletstats receivers",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "description": "OpenTelemetry Collector container image configuration",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "resources": {
      "description": "Container resource requests and limits",
      "type": "object"
    },
    "tolerations": {
      "description": "Pod tolerations for the DaemonSet",
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "projectId",
    "membershipName",
    "location",
    "membershipLocation",
    "namespace",
    "collectionInterval",
    "image"
  ]
}
