{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "projectId": {
      "description": "GCP Fleet Project ID",
      "type": "string",
      "minLength": 1
    },
    "projectNumber": {
      "description": "GCP Fleet Project Number",
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1
    },
    "membershipName": {
      "description": "Fleet Membership Name",
      "type": "string",
      "minLength": 1
    },
    "location": {
      "description": "Fleet Membership Location",
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "description": "Kubernetes Namespace for the Connect Agent",
      "type": "string",
      "minLength": 1
    },
    "replicas": {
      "description": "Number of Connect Agent replicas",
      "type": "integer",
      "minimum": 1
    },
    "gkeConnectApiEndpoint": {
      "description": "GKE Connect API Endpoint",
      "type": "string",
      "minLength": 1
    },
    "image": {
      "description": "Connect Agent container image configuration",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "proxy": {
      "description": "HTTP Proxy configuration",
      "type": "object",
      "properties": {
        "httpProxy": {
          "type": "string"
        }
      }
    },
    "tolerations": {
      "description": "Pod tolerations for Connect Agent",
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "projectId",
    "projectNumber",
    "membershipName",
    "location",
    "namespace",
    "image"
  ]
}
